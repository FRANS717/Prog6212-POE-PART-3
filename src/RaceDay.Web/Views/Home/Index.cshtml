@model HomeIndexViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var filter = Model.Filter;
}

@section Hero {
    <section class="rd-hero">
        <div class="container">
            <h1>Find your <span>next start line</span></h1>
            <p class="lead mb-0">Road runs, walks and cycle tours across South Africa. Pick an event, choose your category and you're in.</p>
        </div>
    </section>
}

<form method="get" asp-action="Index" class="rd-card p-3 p-lg-4 mb-4" role="search" aria-label="Filter events">
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-lg-3">
            <label asp-for="Filter.Type" class="form-label"></label>
            <select name="Type" id="Filter_Type" class="form-select">
                <option value="">All types</option>
                @foreach (var type in RaceDayValues.EventTypes)
                {
                    <option value="@type" selected="@(filter.Type == type)">@type</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label asp-for="Filter.Location" class="form-label"></label>
            <input name="Location" id="Filter_Location" value="@filter.Location" class="form-control" placeholder="e.g. Cape Town" maxlength="100" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="Filter.Date" class="form-label"></label>
            <input name="Date" id="Filter_Date" type="date" value="@filter.Date?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="IncludePast" id="Filter_IncludePast" value="true" checked="@filter.IncludePast" />
                <label class="form-check-label" for="Filter_IncludePast">Include past events</label>
            </div>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-rd flex-fill"><i class="bi bi-funnel"></i> Filter</button>
            @if (filter.HasAny)
            {
                <a asp-action="Index" class="btn btn-rd-outline" title="Clear filters" aria-label="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @Model.Error</div>
}
else if (Model.Events.Count == 0)
{
    <div class="rd-empty text-center">
        <i class="bi bi-calendar-x display-5 text-rd-accent"></i>
        <h2 class="rd-section-title mt-3">No events match</h2>
        <p class="text-muted">Try another type or location, or clear the filters.</p>
        @if (!filter.IncludePast)
        {
            <a asp-action="Index" asp-route-IncludePast="true" asp-route-Type="@filter.Type" asp-route-Location="@filter.Location" class="btn btn-rd-outline">Show past events too</a>
        }
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="rd-section-title mb-0">@(filter.IncludePast ? "All events" : "Upcoming events")</h2>
        <span class="text-muted small">@Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s")</span>
    </div>
    <div class="row g-4">
        @foreach (var item in Model.Events)
        {
            <div class="col-md-6 col-xl-4">
                <partial name="_EventCard" model="item" />
            </div>
        }
    </div>
}

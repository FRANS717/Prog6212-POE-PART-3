@model CategoriesPageViewModel
@{
    ViewData["Title"] = $"Categories · {Model.Event.Name}";
    ViewData["Tab"] = "categories";
    var ev = Model.Event;
}

<partial name="_OrganiserEventHeader" model="ev" view-data="ViewData" />

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card p-4">
            <h2 class="rd-section-title">Categories (@ev.Categories.Count)</h2>
            @if (ev.Categories.Count == 0)
            {
                <p class="text-muted mb-0">No categories yet. Participants can only enter once you add at least one.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var c in ev.Categories)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <strong class="fs-5">@c.Name</strong>
                                    @if (c.MinAge is not null || c.MaxAge is not null)
                                    {
                                        <span class="badge text-bg-light ms-1">Age @(c.MinAge?.ToString() ?? "any")&ndash;@(c.MaxAge?.ToString() ?? "+")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(c.Description))
                                    {
                                        <div class="small text-muted">@c.Description</div>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-rd-outline" type="button" data-bs-toggle="collapse" data-bs-target="#edit-@c.CategoryId" aria-expanded="false" aria-controls="edit-@c.CategoryId" title="Edit"><i class="bi bi-pencil"></i></button>
                                    <form asp-action="Delete" asp-route-eventId="@ev.EventId" asp-route-id="@c.CategoryId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                            <div class="collapse mt-3" id="edit-@c.CategoryId">
                                <form asp-action="Edit" asp-route-eventId="@ev.EventId" asp-route-id="@c.CategoryId" method="post" class="row g-2">
                                    <div class="col-md-6"><input name="Name" value="@c.Name" class="form-control form-control-sm" required maxlength="100" aria-label="Name" /></div>
                                    <div class="col-md-6"><input name="Description" value="@c.Description" class="form-control form-control-sm" maxlength="255" placeholder="Description" aria-label="Description" /></div>
                                    <div class="col-4"><input name="MinAge" value="@c.MinAge" type="number" min="0" max="120" class="form-control form-control-sm" placeholder="Min age" aria-label="Minimum age" /></div>
                                    <div class="col-4"><input name="MaxAge" value="@c.MaxAge" type="number" min="0" max="120" class="form-control form-control-sm" placeholder="Max age" aria-label="Maximum age" /></div>
                                    <div class="col-4"><button type="submit" class="btn btn-sm btn-rd w-100">Save</button></div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card p-4">
            <h2 class="rd-section-title">Add a category</h2>
            <form asp-action="Create" asp-route-eventId="@ev.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="NewCategory.Name" class="form-label"></label>
                    <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. Senior, Under 20, 21km" />
                    <span asp-validation-for="NewCategory.Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewCategory.Description" class="form-label"></label>
                    <input asp-for="NewCategory.Description" class="form-control" placeholder="Optional" />
                    <span asp-validation-for="NewCategory.Description" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.MinAge" class="form-label"></label>
                        <input asp-for="NewCategory.MinAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MinAge" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxAge" class="form-label"></label>
                        <input asp-for="NewCategory.MaxAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxAge" class="text-danger small"></span>
                    </div>
                </div>
                <p class="form-text">Leave the ages empty for a distance category that anyone can enter.</p>
                <button type="submit" class="btn btn-rd w-100"><i class="bi bi-plus-circle"></i> Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

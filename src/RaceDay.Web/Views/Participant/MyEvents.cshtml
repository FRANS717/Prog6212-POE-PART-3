@model List<Enrolment>
@{
    ViewData["Title"] = "My events";
    var today = DateTime.Today;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="rd-title mb-1">My events</h1>
        <p class="text-muted mb-0">Every event you've entered and where your entry stands.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-rd"><i class="bi bi-search"></i> Find an event</a>
</div>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @error</div>
}
else if (Model.Count == 0)
{
    <div class="rd-empty text-center">
        <i class="bi bi-ticket-perforated display-5 text-rd-accent"></i>
        <h2 class="rd-section-title mt-3">No entries yet</h2>
        <p class="text-muted">Browse upcoming events and enter your first race.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Browse events</a>
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-3 mb-3 small">
        <span><partial name="_StatusBadge" model="@("Confirmed")" /> Your place is confirmed</span>
        <span><partial name="_StatusBadge" model="@("Pending")" /> Waiting for the organiser</span>
        <span><partial name="_StatusBadge" model="@("Cancelled")" /> Entry cancelled</span>
    </div>
    <div class="rd-card rd-table-wrap">
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Category</th>
                        <th scope="col">Entered on</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a>
                                @if (e.EventDate.Date < today)
                                {
                                    <span class="badge text-bg-secondary ms-1">Finished</span>
                                }
                            </td>
                            <td>@e.EventDate.ToString("d MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td>@e.RegistrationDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

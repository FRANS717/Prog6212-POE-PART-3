@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="rd-empty text-center py-5">
    <i class="bi bi-cone-striped display-3 text-rd-accent"></i>
    <h1 class="rd-title mt-3">We hit a pothole</h1>
    <p class="lead text-muted">Something went wrong on our side. Your data is safe. Please go back and try again.</p>
    <div class="d-flex justify-content-center gap-2">
        <a href="javascript:history.back()" class="btn btn-rd-outline">Go back</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Back to events</a>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>

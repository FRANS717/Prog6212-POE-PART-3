@model EventDetail
@{
    var active = ViewData["Tab"] as string;
    string Tab(string name) => active == name ? "active" : "";
}
@* Shared header for the per-event Organiser pages, so they look and navigate the same. *@
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-controller="OrganiserEvents" asp-action="Index">Manage events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="rd-title mb-1">@Model.Name</h1>
        <div class="rd-meta">
            <span><i class="bi bi-calendar-event"></i> @Model.Date.ToString("d MMM yyyy, HH:mm")</span>
            <span><i class="bi bi-geo-alt-fill"></i> @Model.Location</span>
            <span><i class="bi bi-signpost-split-fill"></i> @Model.Distance.ToString("0.##") km @Model.EventType</span>
        </div>
    </div>
    <a asp-controller="OrganiserEvents" asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-rd-outline btn-sm"><i class="bi bi-pencil"></i> Edit event</a>
</div>
<ul class="nav nav-pills mb-4 gap-1">
    <li class="nav-item"><a class="nav-link @Tab("categories")" asp-controller="Categories" asp-action="Index" asp-route-eventId="@Model.EventId"><i class="bi bi-tags"></i> Categories</a></li>
    <li class="nav-item"><a class="nav-link @Tab("enrolments")" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@Model.EventId"><i class="bi bi-people"></i> Enrolments</a></li>
    <li class="nav-item"><a class="nav-link @Tab("results")" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@Model.EventId"><i class="bi bi-stopwatch"></i> Results</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId"><i class="bi bi-eye"></i> Public page</a></li>
</ul>

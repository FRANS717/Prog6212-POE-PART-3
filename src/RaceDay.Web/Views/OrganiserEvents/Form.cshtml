@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Edit {Model.Name}" : "New event";
    var banner = Images.For(Model.BannerImageUrl);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Manage events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(Model.IsEdit ? "Edit" : "New event")</li>
    </ol>
</nav>

<h1 class="rd-title mb-4">@(Model.IsEdit ? "Edit event" : "Create an event")</h1>

<form method="post" enctype="multipart/form-data" novalidate
      asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.EventId">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="BannerImageUrl" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="rd-card p-4">
                <h2 class="rd-section-title">Event details</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cape Town 10K Night Run" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Route, start point, what to bring, cut-off times..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="datetime-local" class="form-control" value="@Model.Date?.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Green Point, Cape Town" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(RaceDayValues.EventTypes))"></select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="rd-card p-4">
                <h2 class="rd-section-title">Banner image</h2>
                <div class="rd-event-banner rounded-3 mb-3" id="banner-preview">
                    @if (banner is not null)
                    {
                        <img src="@banner" alt="Current banner" />
                    }
                    else
                    {
                        <div class="rd-banner-icon"><i class="bi bi-image"></i></div>
                    }
                </div>
                <label asp-for="Banner" class="form-label">@(banner is null ? "Upload a banner" : "Replace the banner")</label>
                <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="Banner" class="text-danger small"></span>
                <div class="form-text">JPG, PNG or WEBP up to 5 MB. Stored in Azure Blob Storage through the API.</div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-rd btn-lg"><i class="bi bi-save"></i> @(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Index" class="btn btn-rd-outline">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Preview the chosen banner before it is uploaded.
        document.getElementById('Banner')?.addEventListener('change', e => {
            const file = e.target.files[0];
            if (!file) return;
            const preview = document.getElementById('banner-preview');
            preview.innerHTML = '';
            const img = document.createElement('img');
            img.alt = 'New banner preview';
            img.src = URL.createObjectURL(file);
            preview.appendChild(img);
        });
    </script>
}

@model List<EventSummary>
@using RaceDay.Web.Helpers
@{
    ViewData["Title"] = "Manage events";
    var today = DateTime.Today;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="rd-title mb-1">Manage events</h1>
        <p class="text-muted mb-0">Create, edit and delete your events, and open their categories, enrolments and results.</p>
    </div>
    <a asp-action="Create" class="btn btn-rd"><i class="bi bi-plus-circle"></i> New event</a>
</div>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @error</div>
}
else if (Model.Count == 0)
{
    <div class="rd-empty text-center">
        <i class="bi bi-calendar-plus display-5 text-rd-accent"></i>
        <h2 class="rd-section-title mt-3">No events yet</h2>
        <a asp-action="Create" class="btn btn-rd">Create your first event</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model)
        {
            var banner = Images.For(e.BannerImageUrl);
            <div class="col-md-6 col-xl-4">
                <article class="rd-card h-100 overflow-hidden d-flex flex-column">
                    <div class="rd-event-banner">
                        @if (banner is not null)
                        {
                            <img src="@banner" alt="Banner for @e.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="rd-banner-icon"><i class="bi @StatusStyles.EventTypeIcon(e.EventType)"></i></div>
                        }
                        <span class="rd-type-tag">@e.EventType</span>
                        <div class="rd-event-date">
                            <div class="rd-day">@e.Date.ToString("dd")</div>
                            <div class="rd-month">@e.Date.ToString("MMM yyyy")</div>
                        </div>
                    </div>
                    <div class="p-3 p-lg-4 d-flex flex-column flex-fill">
                        <h2 class="h4 text-uppercase mb-1">@e.Name</h2>
                        <div class="rd-meta mb-3">
                            <span><i class="bi bi-geo-alt-fill"></i> @e.Location</span>
                            <span><i class="bi bi-signpost-split-fill"></i> @e.Distance.ToString("0.##") km</span>
                            @if (e.Date.Date < today)
                            {
                                <span class="badge text-bg-secondary">Finished</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-sm btn-rd"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-tags"></i> Categories</a>
                            <a asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-people"></i> Enrolments</a>
                            <a asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@e.EventId" class="btn btn-sm btn-rd-outline"><i class="bi bi-stopwatch"></i> Results</a>
                            <a asp-action="Delete" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-danger ms-auto" title="Delete"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}

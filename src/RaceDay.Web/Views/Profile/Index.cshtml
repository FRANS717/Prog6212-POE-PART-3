@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var picture = Images.For(Model.ProfilePictureUrl);
    var initials = string.Concat(Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<h1 class="rd-title mb-4">My profile</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card p-4 text-center h-100">
            @if (picture is not null)
            {
                <img src="@picture" alt="Profile picture of @Model.FullName" class="rd-avatar mb-3" />
            }
            else
            {
                <div class="rd-avatar mb-3" aria-hidden="true">@initials</div>
            }
            <h2 class="h4 mb-0">@Model.FullName</h2>
            <p class="text-muted mb-3"><span class="rd-role-pill ms-0">@Model.Role</span></p>

            @if (!Model.IsOrganiser)
            {
                <form asp-action="Picture" method="post" enctype="multipart/form-data" class="text-start">
                    <label for="image" class="form-label">Profile picture</label>
                    <input type="file" name="image" id="image" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" required />
                    <div class="form-text mb-3">JPG, PNG or WEBP, up to 5 MB.</div>
                    <button type="submit" class="btn btn-rd-outline w-100"><i class="bi bi-cloud-upload"></i> Upload picture</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card p-4">
            <h2 class="rd-section-title">Personal details</h2>
            <form asp-action="Index" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    @if (Model.IsOrganiser)
                    {
                        <div class="col-md-6">
                            <label asp-for="OrganisationName" class="form-label"></label>
                            <input asp-for="OrganisationName" class="form-control" />
                            <span asp-validation-for="OrganisationName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label"></label>
                            <input asp-for="ContactNumber" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" autocomplete="bday" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-rd mt-4"><i class="bi bi-save"></i> Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

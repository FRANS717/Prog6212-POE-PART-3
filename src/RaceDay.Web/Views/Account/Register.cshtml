@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    var isOrganiser = Model.Role == RaceDayValues.Organiser;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="rd-card p-4 p-md-5">
            <h1 class="rd-title mb-1">Create your account</h1>
            <p class="text-muted mb-4">Choose how you'll use RaceDay. You can't change your role later.</p>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <fieldset class="mb-4">
                    <legend class="form-label fs-6">I am a...</legend>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="role-participant" />
                            <label class="btn btn-role w-100" for="role-participant">
                                <i class="bi bi-person-arms-up fs-3 d-block"></i>
                                <strong>Participant</strong>
                                <span class="d-block small">Enter events and track my results</span>
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="role-organiser" />
                            <label class="btn btn-role w-100" for="role-organiser">
                                <i class="bi bi-flag fs-3 d-block"></i>
                                <strong>Organiser</strong>
                                <span class="d-block small">Create events and capture results</span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </fieldset>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6" data-role-field="Organiser" hidden="@(!isOrganiser)">
                        <label asp-for="OrganisationName" class="form-label"></label>
                        <input asp-for="OrganisationName" class="form-control" />
                        <span asp-validation-for="OrganisationName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6" data-role-field="Organiser" hidden="@(!isOrganiser)">
                        <label asp-for="ContactNumber" class="form-label"></label>
                        <input asp-for="ContactNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6" data-role-field="Participant" hidden="@isOrganiser">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" autocomplete="bday" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        <div class="form-text">Used to check you're in the right age category.</div>
                    </div>
                </div>

                <button type="submit" class="btn btn-rd w-100 mt-4">Create account</button>
            </form>

            <p class="mt-4 mb-0 text-center">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show only the fields that belong to the chosen role. The server checks them again either way.
        document.querySelectorAll('input[name="Role"]').forEach(radio => radio.addEventListener('change', () => {
            document.querySelectorAll('[data-role-field]').forEach(field => {
                field.hidden = field.dataset.roleField !== radio.value;
            });
        }));
    </script>
}
